model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files           File[]
  emailsReceived  Email[]  @relation("EmailRecipient")

  @@map("users")
}