generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Import all models
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files          File[]
  emailsReceived Email[] @relation("EmailRecipient")

  @@map("users")
}

model File {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  mimetype  String?
  size      Int?
  userId    Int?
  userName  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("files")
}

model Email {
  id          Int      @id @default(autoincrement())
  to          String
  subject     String
  body        String   @db.Text
  htmlBody    String?  @db.Text
  sentAt      DateTime @default(now())
  status      String   @default("sent") // sent, failed, pending
  error       String?  @db.Text
  userId      Int? // who sent the email (admin)
  recipientId Int? // user who received the email
  recipient   User?    @relation("EmailRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("emails")
}
