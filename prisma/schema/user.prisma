model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   
  name      String?
  avatar    String?  // 👈 ADD THIS FIELD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     File[]   // 👈 ADD THIS RELATION (optional)

  @@map("users")
}